# Güvenlik Şövalyesi — ortam değişkenleri (.env olarak kopyala, gerçek değerleri gir)

# Admin API token'ı. Set edilirse TÜM /api/* uçları Bearer bu token'ı ister.
# Boşsa server.mjs "dev-open" modda yalnız 127.0.0.1'e izin verir (üretimde MUTLAKA set et).
SK_ADMIN_TOKEN=

# CORS izinli origin (wildcard YOK). Panelin sunulduğu origin.
SK_ALLOWED_ORIGIN=http://127.0.0.1:8137

# Yerel dev backend portu
PORT=8137

# Bu paneli KENDİ ebeveyn dizini yerine başka bir projeye yöneltmek için (mutlak yol,
# ör. /Users/sen/projelerim/proje-x). Boşsa panel varsayılan olarak kendi ebeveyn dizinini
# (bu repo ya da `warden init` ile içine kurulduğu proje) tarar.
WARDEN_TARGET=
